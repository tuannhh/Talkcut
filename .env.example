GEMINI_API_KEY=
GEMINI_CONTENT_MODEL=gemini-3.8-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
PORT=8092
# Thu muc video nguon, duoc mount chi-doc vao Docker tai /sources (de duyet
# san file co san; ngoai ra van upload truc tiep tu giao dien duoc). Mac dinh
# la ./sources ngay trong bo cai — chay tot tren moi may. De tro toi thu muc
# khac hay dung dau gach cheo xuoi, vi du Windows: C:/Users/TenBan/Videos
SOURCE_DIR=./sources
MAX_UPLOAD_GB=10
RENDER_THREADS=4
FACE_ENGINE_WORKERS=2

# ---- NVIDIA GPU acceleration (single image, auto-detected) ----
# One image handles both CPU-only and GPU machines — nothing to rebuild or
# switch here. `./scripts/start.sh` detects an NVIDIA GPU + Container
# Toolkit and adds the `compose.gpu.yaml` overlay automatically; without it
# (or on a machine with no NVIDIA GPU) everything runs on CPU exactly as
# before. Everything below is safe to leave unset: "auto" only turns the
# GPU path on when a GPU is actually detected. Explicit values override
# auto-detection, and can also be changed at runtime from the app's
# settings modal (gear icon -> "Tăng tốc phần cứng") without a rebuild.
#
# RENDER_ACCEL=auto             # auto|cuda|cpu — ffmpeg NVENC encode + NVDEC/CUDA decode
# FACE_ENGINE_ACCEL=auto        # auto|cuda|cpu — SCRFD/ArcFace on CUDA execution provider (status-only in the UI; change here + rebuild to switch)
# FACE_ENGINE_WORKERS=          # leave unset to auto-tier by detected VRAM: 2GB->2, 4GB->4, 6GB->6, 8GB+->8
# FACE_ENGINE_GPU_MEM_LIMIT_MB= # leave unset to auto-split detected VRAM evenly across workers
